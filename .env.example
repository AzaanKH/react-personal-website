# Copy to .env for `netlify dev`, and set the same values in Netlify
# (Site configuration > Environment variables). All are server-side only;
# none use the VITE_ prefix, so none are bundled into the browser.

# Steam Web API (netlify/functions/steam-proxy.js)
# Key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=YOUR_STEAM_API_KEY_HERE
# 64-bit Steam ID. The proxy only ever serves this account.
STEAM_ID=YOUR_STEAM_ID_HERE

# Contact form delivery via Resend (netlify/functions/contact.js)
# https://resend.com — without these the contact endpoint returns 503.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=you@example.com
# Must be on a domain verified in Resend. "Portfolio <onboarding@resend.dev>"
# works for testing but only delivers to your Resend account's email.
CONTACT_FROM_EMAIL=Portfolio <contact@yourdomain.com>
